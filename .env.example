# SiberMonitorLive — konfigurasi environment
# Salin ke .env atau set langsung di environment server

# Admin master (super admin) — wajib diganti di production!
ADMIN_USER=admin
ADMIN_PASS=gantiPasswordIni

# Port server
PORT=3000

# Interval refresh stream (detik)
POLL_INTERVAL_SEC=60

# Browser engine utama: true=headless (default), false=terlihat untuk debug
# HEADLESS=true

# Browser komentar TikTok memakai profil anonim terpisah.
# Default mengikuti HEADLESS. Set false hanya saat perlu menyelesaikan CAPTCHA manual.
# TIKTOK_COMMENT_HEADLESS=false
# TIKTOK_COMMENT_PROFILE_DIR=./data/chromium-comment-profile
# TIKTOK_COMMENT_BUFFER=200

# Service Python tiktok-live-checker untuk popup detail TikTok
TIKTOK_DETAIL_SERVICE_URL=http://127.0.0.1:9001
# Batas waktu request detail (ms) dan cache per username (detik)
# TIKTOK_DETAIL_TIMEOUT_MS=45000
# TIKTOK_DETAIL_CACHE_SEC=20
